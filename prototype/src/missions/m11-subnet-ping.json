{
  "id": "m11-subnet-ping",
  "title": "Same Subnet Ping",
  "order": 11,
  "track": "logic",
  "lesson": "Hosts only ARP/ping each other directly when they share a subnet. Mismatched masks are a classic ticket. Practice /24 first (CCNA fundamentals).",
  "brief": "SERVER-01 and the firewall LAN are both in 10.10.10.0/24. Patch SERVER-01 to Gi1/0/5, set eth0 to 10.10.10.10/24, then ping SERVER-01 → FW-EDGE.",
  "constraints": [
    "Keep SERVER-01 on VLAN 10",
    "Use 10.10.10.10/24 on eth0",
    "FW LAN is already 10.10.10.1/24"
  ],
  "parTimeSec": 150,
  "hintAfterWrongAttempts": 2,
  "inventory": {
    "copper_cat6": 4,
    "fiber_om4": 0,
    "power_c13": 0,
    "console_rj45": 0
  },
  "initial": {
    "devices": [],
    "cables": [
      {
        "id": "c-fw-lan",
        "media": "copper_cat6",
        "color": "yellow",
        "lengthM": 1,
        "ends": [
          { "deviceId": "fw-1", "portId": "fw-lan" },
          { "deviceId": "tor-1", "portId": "sw-2" }
        ]
      }
    ]
  },
  "goals": [
    {
      "type": "link_up",
      "a": { "deviceId": "tor-1", "portId": "sw-5" },
      "b": { "deviceId": "server-01", "portId": "nic-1" }
    },
    {
      "type": "iface_ip",
      "port": { "deviceId": "server-01", "portId": "nic-1" },
      "address": "10.10.10.10",
      "prefix": 24
    },
    {
      "type": "ping",
      "fromDeviceId": "server-01",
      "toDeviceId": "fw-1"
    }
  ]
}
