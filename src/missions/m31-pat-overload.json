            }
          },
          {
            "id": "srv1-con",
            "deviceId": "server-01",
            "index": 2,
            "label": "CON",
            "media": "console_rj45",
            "connector": "console",
            "kind": "console",
            "admin": "up",
            "role": "console"
          },
          {
            "id": "srv1-psu",
            "deviceId": "server-01",
            "index": 3,
