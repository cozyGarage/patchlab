{
  "id": "m19-broken-address",
  "title": "Broken Address",
  "order": 19,
  "track": "routing",
  "lesson": "Same-subnet reachability starts with a correct host IP. A perfect cable still fails when the address is on the wrong network \u2014 fix the IP, then prove it with ping. Better than a bare puzzle: the rack is already live, so the tip tells you exactly what broke.",
  "brief": "SERVER-01 has healthy copper and power, but cannot reach FW-EDGE. Someone mis-addressed the host \u2014 restore LAN reachability and prove it with a ping.",
  "constraints": [
    "Do not unpatch working copper",
    "Repair host addressing only"
  ],
  "parTimeSec": 90,
  "hintAfterWrongAttempts": 2,
  "inventory": {
    "copper_cat6": 2,
    "fiber_om4": 0,
    "power_c13": 0,
    "console_rj45": 0
  },
  "initial": {
