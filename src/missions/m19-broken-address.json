        "ports": [
          {
            "id": "nic-1",
            "deviceId": "server-01",
            "index": 1,
            "label": "eth0",
            "media": "copper_cat6",
            "connector": "rj45",
            "kind": "data",
            "admin": "up",
            "role": "nic",
            "accessVlan": 10,
            "ip": {
              "address": "10.10.99.10",
              "prefix": 24,
              "gateway": "10.10.10.1"
            }
          },
          {
            "id": "srv1-con",
            "deviceId": "server-01",
            "index": 2,
            "label": "CON",
            "media": "console_rj45",
            "connector": "console",
            "kind": "console",
            "admin": "up",
            "role": "console"
          },
          {
            "id": "srv1-psu",
            "deviceId": "server-01",
            "index": 3,
