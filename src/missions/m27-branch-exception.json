        "ends": [
          { "deviceId": "tor-1", "portId": "sw-5" },
          { "deviceId": "server-01", "portId": "nic-1" }
        ]
      },
      {
        "id": "c-srv-b",
        "media": "copper_cat6",
        "color": "blue",
        "lengthM": 2,
        "ends": [
          { "deviceId": "tor-1", "portId": "sw-7" },
          { "deviceId": "server-07", "portId": "nic-1" }
        ]
      }
    ]
  },
  "goals": [
    { "type": "console_attached", "deviceId": "fw-1" },
    {
      "type": "firewall_rule",
      "action": "permit",
      "srcCidr": "10.10.10.10/32",
      "dstCidr": "198.51.100.10/32"
    },
    {
      "type": "ping",
      "fromDeviceId": "server-01",
      "toDeviceId": "branch-01"
    },
    {
      "type": "ping_fail",
      "fromDeviceId": "server-07",
      "toDeviceId": "branch-01"
    }
  ]
}
