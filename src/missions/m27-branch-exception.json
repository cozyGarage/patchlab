        "ports": [
          { "id": "nic-1", "deviceId": "server-07", "index": 1, "label": "eth0", "media": "copper_cat6", "connector": "rj45", "kind": "data", "admin": "up", "role": "nic", "accessVlan": 10, "ip": { "address": "10.10.10.20", "prefix": 24, "gateway": "10.10.10.1" } },
          { "id": "srv7-psu", "deviceId": "server-07", "index": 2, "label": "PSU", "media": "power_c13", "connector": "c13", "kind": "power", "admin": "up", "role": "power" }
        ]
